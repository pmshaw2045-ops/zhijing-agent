# 织镜 ZHÌJÌNG — 环境变量模板
# 复制为 .env 并填入实际值

# ============================================================
# LLM Provider（核心依赖，必填）
# 支持任意 OpenAI 兼容 API（DeepSeek / OpenAI / 等）
# ============================================================
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com

# 按任务分级配置（可选，不配则所有任务共享 LLM_MODEL_FLASH）
# LLM_MODEL_FLASH=deepseek-chat      # 意图识别 / 工具提取
# LLM_MODEL_PRO=deepseek-v4-pro      # DAG 拆解 / 质量审查
# LLM_MODEL_CHAT=deepseek-chat       # 报告生成 / 反思

# ============================================================
# 旧兼容：二选一即可（DEEPSEEK_* 仍生效）
# ============================================================
# DEEPSEEK_API_KEY=your-deepseek-key

# ============================================================
# 文生图（可选，无此 key 则图片生成不可用）
# ============================================================
ARK_API_KEY=your-ark-key

# ============================================================
# 搜索 API（可选，无 key 时会优雅降级，LLM 基于自身知识输出）
# ============================================================
TAVILY_API_KEY=your-tavily-key
BOCHA_API_KEY=your-bocha-key

# 统一配置（推荐）：一个 key 覆盖所有搜索
# SEARCH_API_KEY=your-search-api-key
# SEARCH_PROVIDER=auto    # auto | tavily | bocha

# ============================================================
# 环境
# ============================================================
APP_ENV=production

# 认证（生产环境必改）
API_TOKEN=change-me-to-a-random-string

# 存储后端（json 或 sqlite）
STORE_BACKEND=json
