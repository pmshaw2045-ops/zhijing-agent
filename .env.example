# 织镜 ZHÌJÌNG — 环境变量模板
# 复制为 .env 并填入实际值

# ============================================================
# LLM（核心依赖，必填）
# 支持任意 OpenAI 兼容 API（DeepSeek / OpenAI / 等）
# ============================================================
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1

# 分级模型（可选，不配则所有任务使用同一个模型）
# LLM_MODEL_FLASH=gpt-4o-mini          # 意图识别/工具提取（快速）
# LLM_MODEL_PRO=gpt-4o                  # DAG拆解/质量审查（推理）
# LLM_MODEL_CHAT=gpt-4o-mini           # 报告生成/反思（标准）

# ============================================================
# 搜索（可选，不配也不报错，LLM 会基于自身知识输出）
# ============================================================
SEARCH_API_KEY=your-search-api-key
SEARCH_PROVIDER=auto         # auto | tavily | bocha

# ============================================================
# 文生图（可选）
# ============================================================
ARK_API_KEY=your-ark-key

# ============================================================
# 环境 / 运行
# ============================================================
APP_ENV=production
API_TOKEN=change-me-to-a-random-string
STORE_BACKEND=json
