# ============================================================
# 织镜 Fashion Agent — 生产环境配置
# 使用: APP_ENV=prod 时自动加载此文件
# 安全: 所有密钥通过环境变量注入，此文件仅含非敏感默认值
# ============================================================

# API 认证
API_TOKEN=chang...ne

# DeepSeek LLM
DEEPSEEK_API_KEY=***BASE_URL=https://api.deepseek.com

# 豆包 Seedream 文生图
ARK_API_KEY=*** 博查中文搜索
BOCHA_API_KEY=*** Tavily 英文搜索
TAVILY_API_KEY=*** 日志级别 (prod 默认 warning)
LOG_LEVEL=warning

# 请求超时 (秒)
REQUEST_TIMEOUT=120
