# ============================================================
# 织镜 ZHÌJÌNG — 生产环境配置
# APP_ENV=production 时自动加载此文件（覆盖 .env 基础值）
# 注意：此文件提交到仓库，不要放真实密钥
# ============================================================

# API 认证（生产环境必改）
API_TOKEN=change-me-to-a-random-string

# DeepSeek LLM
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 豆包 Seedream 文生图
ARK_API_KEY=your-ark-key

# 博查中文搜索
BOCHA_API_KEY=your-bocha-key

# Tavily 英文搜索
TAVILY_API_KEY=your-tavily-key

# 运行配置
APP_ENV=production
LOG_LEVEL=warning
REQUEST_TIMEOUT=120
